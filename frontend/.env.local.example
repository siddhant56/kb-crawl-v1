# ──────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────────

# FastAPI backend URL — server-side only (never sent to the browser).
# Change this if the FastAPI app runs on a different host/port.
API_BASE_URL=http://localhost:8000

# JWT secret — MUST match AUTH_JWT_SECRET in the backend .env file exactly.
# The middleware decodes JWTs locally using this secret (no network call).
AUTH_JWT_SECRET=CHANGE-THIS-SECRET-KEY-AT-LEAST-32-CHARS
